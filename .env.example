# ── Model Selection (M1 Pro 16GB optimized) ───────────────────────────────────
# The authoritative list lives in config/models.registry.json — run
# `make models` to see every registered model and which are installed.
# setup.sh warns if the tags below are unregistered or marked broken.
#
# Inference backend — EXCLUSIVE: Ollama (false, default) or Apple MLX (true).
# Memory is the limiting factor, so only one runtime is started and there is no
# per-request switching. MLX runs natively on the Mac (mlx_lm.server on :8081).
# Switch with `make use-mlx` / `make use-ollama`. See docs/MLX_INTEGRATION.md.
# With USE_MLX=true, DEFAULT_MODEL/LLM_MODEL are ignored for chat; MLX_MODEL
# (a registry id with backend "mlx") is used instead. Embeddings stay on Ollama.
USE_MLX=false
# MLX_MODEL=muse-glimmer
# MLX_BASE_URL=http://localhost:8081/v1   # native API; compose uses host.docker.internal

# Default model — a registry id; the single source of truth every service reads.
# The Ollama tag is looked up in the registry (llama3.1-8b -> llama3.1:8b).
DEFAULT_MODEL=llama3.1-8b
# Optional explicit Ollama-tag override of DEFAULT_MODEL (leave unset normally):
#   nemotron-3-nano:4b   ~2.8 GB  NVIDIA agentic model — tools + reasoning, 256K context
#   llama3.2:3b          ~2.0 GB  fast, great for testing
#   llama3.1:8b          ~4.9 GB  default — strong general chat/RAG baseline
#   mistral:7b-q4_K_M    ~4.4 GB  strong reasoning, good for RAG
#   phi3.5:3.8b          ~2.2 GB  fast, strong at instruction-following
# LLM_MODEL=

# LangSmith tracing (optional; off unless enabled)
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=localaistack

# LangGraph checkpoint database (SQLite), thread-scoped graph state
CHECKPOINT_DB_PATH=/app/state/checkpoints.sqlite

# Persistence: sqlite (default) or postgres (durable checkpointer + store; see docs/HA_DEPLOYMENT.md)
CHECKPOINT_BACKEND=sqlite
# DATABASE_URL=postgresql://localai:<password>@postgres:5432/localai
# POSTGRES_POOL_SIZE=10
# POSTGRES_AUTO_SETUP=true

# Chat-model provider: ollama (default) or openai / anthropic / google_genai ...
# Non-ollama needs LLM_MODEL plus the provider's key (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...)
# and `pip install -r services/api/requirements-providers.txt`. See docs/PROVIDERS_AND_TRACING.md
LLM_PROVIDER=ollama
# LLM_BASE_URL=

# Tracing backend: none | langsmith | otel (LANGSMITH_* above, or the OTEL_* below)
TRACING_BACKEND=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=localaistack-api

# OEE governance layer (docs/GOVERNANCE.md)
GOVERNANCE_ENABLED=true
# Set a secret to keep capability tokens valid across restarts/replicas (required by the HA overlay)
# GOVERNANCE_TOKEN_SECRET=
GOVERNANCE_REQUIRE_TOKEN=false
# GOVERNANCE_CHAIN_PATH=/app/state/provenance.jsonl
GOVERNANCE_PREDICTIVE_ENABLED=false

# Embedding model (lightweight, 768-dim)
# EMBED_DIM must match the model's embed_dim in the registry AND the existing
# localai_docs Qdrant collection — recreate the collection when you swap.
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Model registry override. Empty = auto-resolve (repo config/ locally,
# /app/config in the api container).
# MODELS_REGISTRY_PATH=

# Physical host RAM in GB, used only to report fits_host in GET /models.
# Set this when running in Docker Desktop, where the container sees the Linux
# VM's memory allocation rather than the Mac's.
# HOST_RAM_GB=16

# ── RAG Configuration ─────────────────────────────────────────────────────────
COLLECTION_NAME=localai_docs

# RealityEngine endpoint targets. Defaults match the CI Docker public contract.
# RE is published on host :5001 (host :3000 is Grafana). PE is on host :3004.
#
# IMPORTANT — native multi-engine mode (issue #44): when the engines run
# NATIVELY (startUniverse.sh --engines=...), the Docker ports below do NOT
# exist and the api bridge will silently report `bridge: degraded` with
# re/pe unreachable. In that mode point the bridge at the native engine
# (default scala-1, http, no TLS):
#   RE_URL=http://host.docker.internal:5101
#   PE_URL=http://host.docker.internal:5100
#   RE_SSL_VERIFY=false
# startUniverse.sh stage 5 sets these automatically; only override manually
# if you start the api yourself (e.g. `docker compose up -d api`).
RE_URL=https://host.docker.internal:5001
PE_URL=https://host.docker.internal:3004
RE_SSL_VERIFY=false

# ── Security ──────────────────────────────────────────────────────────────────
WEBUI_SECRET_KEY=change-me-before-use

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
